# Firebase configuration for the Shady & Maryam wedding invitation
# (artifacts/wedding-invite). These are OPTIONAL — if any are missing,
# the RSVP form and guestbook automatically fall back to localStorage
# so the site still works fully without Firebase.
#
# To enable Firebase Firestore persistence:
# 1. Create a project at https://console.firebase.google.com
# 2. Create a Firestore database (production or test mode)
# 3. Register a Web App in Project Settings to get these values
# 4. Set them as environment variables (prefixed with VITE_ so Vite exposes
#    them to the frontend build)
# 5. Firestore collections used: "rsvps" and "guestbook"

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
